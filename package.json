{
  "name": "autobot-command-center",
  "version": "0.8.0",
  "private": true,
  "description": "A one-shot Playwright RSVP automation lab for an organizer-owned test event.",
  "type": "module",
  "scripts": {
    "setup:browsers": "playwright install chromium",
    "mock": "tsx src/mock/server.ts",
    "inspect": "tsx src/cli/inspect.ts",
    "reserve": "tsx src/cli/reserve.ts",
    "control:dev": "npm --prefix control-panel run dev",
    "control:build": "npm --prefix control-panel run build",
    "device:pair": "tsx src/control/pair.ts",
    "device": "tsx src/control/device-agent.ts",
    "device:install": "tsx src/control/install-service.ts",
    "device:uninstall": "tsx src/control/install-service.ts --remove",
    "device:simulate": "tsx src/control/simulate.ts",
    "test:control": "tsx src/control/test-controller.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.54.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
